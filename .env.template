# Required
OPENAI_API_KEY=
HEYGEN_API_KEY=

# Optional — if blank, defaults are used (Anna_public_3_20240108, gpt-5.4, medium)
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
HEYGEN_QUALITY=medium
LLM_MODEL=gpt-5.4

# Streaming STT — when set, push-to-talk uses Deepgram (low latency).
# When blank, falls back to OpenAI Whisper buffered transcription.
# Get a key at https://console.deepgram.com/
DEEPGRAM_API_KEY=

# ElevenLabs voice prosody knobs (lower stability + higher style = more lively).
# Set these only if you want to override what's saved on the voice in the
# ElevenLabs dashboard.
# VOICE_STABILITY=0.32
# VOICE_STYLE=0.55
# VOICE_SIMILARITY=0.85
# VOICE_SPEED=1.0
